@baseurl=http://workshop-api-a1.localho.st:8080
@idp=http://keycloak.localho.st:8080/realms/workshop
@tokenEndpoint={{idp}}/protocol/openid-connect/token
# GET {{baseurl}} HTTP/1.1

###

GET {{baseurl}}/healthz/ready

###

GET {{baseurl}}/healthz/live

###

GET {{baseurl}}/healthz

### Retrieve user access token of type bearer from keycloak

# # @name userTokenRequest
# curl --request POST \
#  --url "{{tokenEndpoint}}" \
#  --header "Content-Type: application/x-www-form-urlencoded" \
#  --data client_id=workshop-client \
#  --data username=user \
#  --data password=password \
#  --data realm=workshop \
#  --data grant_type=password

### Retrieve user access token of type bearer from keycloak

# @name userTokenRequest
POST {{tokenEndpoint}}
Content-Type: application/x-www-form-urlencoded

client_id=workshop-client
&client_secret=todo-set-up-ws-client-secret-with-eso-and-retrieve-with-kubectl-here
&username=user
&password=password
&realm=workshop
&grant_type=password

### Retrieve client (service account) token

# @name clientTokenRequest
POST {{tokenEndpoint}}
Content-Type: application/x-www-form-urlencoded

client_id=workshop-client
&client_secret=todo-set-up-ws-client-secret-with-eso-and-retrieve-with-kubectl-here
&realm=workshop
&grant_type=client_credentials

###

@authToken = {{userTokenRequest.response.body.access_token}}
# @authToken = {{clientTokenRequest.response.body.access_token}}
# @authToken = invalid

###

POST {{baseurl}}/store
Content-Type: application/json
Authorization: Bearer {{authToken}}
X-Correlation-Id: submitting correlation id should be optional

{
    "Key": "my first key!",
    "Value": "the very bestest first value",
    "Headers": {
        "these": "first value",
        "values": "2nd value",
        "should": "moaar",
        "be": "I can has value?",
        "optional": "truely"
    }
}

###

POST {{baseurl}}/store
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "Key": "meny",
    "Value": "Using crc32 'meny' should collide with 'menthols'"
}

###

POST {{baseurl}}/store
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "Key": "menthols",
    "Value": "Using crc32 'menthols' should collide with 'meny'"
}

###

POST {{baseurl}}/retrieve
Authorization: Bearer {{authToken}}
Content-Type: application/json
X-Correlation-Id: nah

{
    "Key": "my first key!"
}

###

POST {{baseurl}}/retrieve
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "Key": "meny"
}

###

POST {{baseurl}}/retrieve
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "Key": "menthols"
}

###

POST {{baseurl}}/remove
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "Key": "my first key!"
}

###

POST {{baseurl}}/remove
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "Key": "meny"
}

###

POST {{baseurl}}/remove
